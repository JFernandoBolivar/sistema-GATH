# ── Conexión al backend (la que usa el código actual) ────────────────────────
# URL del backend Django vista desde el contenedor Next.js (solo servidor, nunca llega al
# navegador). compose.yml ya la fija a http://djangoapp:8000 (alias del servicio django).
DJANGO_API_SERVER=http://djangoapp:8000

# ── Sesión ───────────────────────────────────────────────────────────────────
# Atributo Secure de las cookies de sesión dj_access/dj_refresh (solo servidor).
# Default si se omite: true en producción (coherente con DJANGO_COOKIE_SECURE del
# backend). Poner false únicamente si se sirve por HTTP sin TLS (acceso por IP);
# en cuanto haya HTTPS, true.
AUTH_COOKIE_SECURE=true
# URL pública del sistema. En compose.yml se fija con NEXTAUTH_URL del .env de la raíz.
NEXTAUTH_URL="http://ip_publica_server:3000"
NEXTAUTH_URL_MOBILE="http://ip_publica_server:3000"
AUTH_TRUST_HOST=true

# ── Claves heredadas (compatibilidad; el código actual no las exige) ─────────
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET="<CAMBIAR>"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="<CAMBIAR>"
AUTH_RESEND_KEY="re_tu_resend_api_key_aqui"

# ── URLs heredadas (solo respaldo si falta DJANGO_API_SERVER) ────────────────
# URL para peticiones del servidor (dentro del contenedor)
NEXT_PUBLIC_DJANGO_API_URL_SERVER="http://django:8000/api/"
# URL para peticiones del cliente (navegador)
NEXT_PUBLIC_DJANGO_API_URL="http://ip_publica_server:8000/api/"
NEXT_PUBLIC_API_URL="http://ip_publica_server:3000/api"
NEXT_PUBLIC_NEST_API_URL_SERVER="http://nombre_de_red:5000/"
NEXT_PUBLIC_NEST_API_URL="http://ip_publica_server:5000/"

# ── Solo desarrollo ──────────────────────────────────────────────────────────
# Orígenes adicionales permitidos en `next dev` (separados por coma), p. ej.
# http://172.16.10.209:3000.
ALLOWED_DEV_ORIGINS=
