# Regla S3: obligatoria, sin valor por defecto en settings.py. Generar con:
# python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(64)))"
DJANGO_SECRET_KEY=reemplazar-por-clave-generada-unica-por-entorno

DJANGO_DB_NAME=SIGEP
DJANGO_DB_USER=usuario_db
DJANGO_DB_PASSWORD=clave
DJANGO_DB_HOST=0.0.0.0
DJANGO_DB_PORT=5432 #puerto asignado a la base de datos
# Con docker compose, DJANGO_DB_HOST lo fija compose.yml (variable DJANGO_DB_HOST del .env de la raíz).



# Regla S3: obligatoria para que funcione el envío real de correo
# (recuperación de contraseña, notificaciones). Sin valor por defecto en
# settings.py -- si falta, EMAIL_HOST_PASSWORD queda vacío y el envío de
# correo falla explícito en vez de usar una contraseña real hardcodeada.
EMAIL_HOST=mail.conatel.gob.ve
EMAIL_PORT=587
EMAIL_HOST_USER=conatelenlinea@conatel.gob.ve
EMAIL_HOST_PASSWORD=reemplazar-por-la-clave-real-del-correo-institucional


DJANGO_DEBUG=False
# Cookies Secure: True solo cuando el sistema se sirva por HTTPS.
DJANGO_COOKIE_SECURE=False
# A-05: endurecimiento TLS. Si no se definen, con DJANGO_DEBUG=False quedan
# seguros (cookies Secure, redirección a HTTPS y HSTS de 1 año). En local por
# http://localhost hay que dejarlos en False/0 como aquí.
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_PROXY_SSL_HEADER=False

# Hosts y orígenes del despliegue (sin estos, solo funciona localhost).
# Incluir el hostname del servicio en Docker (django) y las IPs/dominios reales.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,django
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# URL pública del frontend (enlaces de recuperación de contraseña, validador de carnets).
FRONTEND_URL=http://localhost:3001
DEFAULT_FROM_EMAIL=GATH CONATEL <gath@conatel.gob.ve>

# Carnetización. CARNET_VALIDATOR_URL por defecto: FRONTEND_URL + /validar.
# CARNET_VALIDATOR_URL=http://localhost:3001/validar
# Solo Windows (desarrollo fuera de Docker): carpeta bin de poppler. En Linux/Docker se usa el PATH.
# POPPLER_PATH=C:\poppler\Library\bin

# Con docker compose, REDIS_URL, CELERY_BROKER_URL y CELERY_RESULT_BACKEND los arma compose.yml.
# Redis como caché de Django (lo arma compose.yml). Sin esto se usa la tabla de PostgreSQL.
# REDIS_URL=redis://:clave@redis:6379/0
# Dominio que se completa al iniciar sesión con correo sin dominio (usuario -> usuario@dominio).
DOMINIO_CORREO_INSTITUCIONAL=conatel.gob.ve
# Los avisos por correo a Bienestar y de movimientos, y los plazos, se configuran en
# Administración del sistema → Configuración → Parámetros (D9), no en el entorno.

# Almacenamiento de archivos (SeaweedFS, gateway S3). OBLIGATORIO: sin el
# endpoint, toda subida (fotos de fe de vida, soportes, carnet) responde
# «El servicio de almacenamiento de archivos no está disponible».
# `sw-s3` es el alias del servicio sw_s3 en la red `storage` de compose.yml.
SEAWEEDFS_S3_ENDPOINT=http://sw-s3:8333
SEAWEEDFS_S3_ACCESS_KEY=__GENERAR__
SEAWEEDFS_S3_SECRET_KEY=__GENERAR__
SEAWEEDFS_S3_BUCKET=gath-storage

# ── Seguridad / sesión (opcionales) ──────────────────────────────────────────
# Clave de firma de los JWT. Si falta, se usa DJANGO_SECRET_KEY.
# DJANGO_JWT_SIGNING_KEY=<CAMBIAR>
# Correo: usar TLS (STARTTLS) y tiempo máximo de conexión en segundos.
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
# Motor de correo de Django. En local sin SMTP: django.core.mail.backends.console.EmailBackend
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# URL del enlace de verificación del código QR de fe de vida (por defecto FRONTEND_URL + /fe-de-vida/verificar).
# FE_DE_VIDA_URL_VERIFICACION=http://localhost:3001/fe-de-vida/verificar
# Lado mínimo (px) de la foto de evidencia de fe de vida.
FE_DE_VIDA_EVIDENCIA_LADO_MINIMO_PX=480

# ── Base de datos: conexiones (opcionales) ───────────────────────────────────
# Segundos que se reutiliza una conexión a PostgreSQL y verificación al reutilizarla.
DJANGO_CONN_MAX_AGE=600
DJANGO_CONN_HEALTH_CHECKS=True

# ── Servidor de aplicación (gunicorn, opcionales) ────────────────────────────
# Por defecto: 2*CPU+1 procesos, 2 hilos y 60 s de tiempo máximo por petición.
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=60

# ── Límites de peticiones (opcionales; formato N/minute) ─────────────────────
LOGIN_THROTTLE_RATE=30/minute
PASSWORD_RESET_THROTTLE_RATE=10/minute
FE_DE_VIDA_VERIFICACION_PUBLICA_THROTTLE_RATE=30/minute
UPLOAD_THROTTLE_RATE=20/minute
EXPORT_THROTTLE_RATE=60/minute
REFRESH_THROTTLE_RATE=60/minute

# ── Subida de archivos y antivirus (opcionales) ──────────────────────────────
# Tamaño máximo de un archivo subido, en bytes (10 MB).
MAX_UPLOAD_SIZE=10485760
# Escaneo con ClamAV: activar solo si hay un servicio clamd accesible.
ANTIVIRUS_HABILITADO=False
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Reportes y exportaciones asíncronas (opcionales) ─────────────────────────
REPORTES_MAX_FILAS=5000
REPORTES_MAX_FILAS_PDF=5000
# Horas que se conserva un archivo exportado antes de borrarse.
EXPORTACIONES_TTL_HORAS=24
EXPORTACIONES_MAX_ACTIVAS_POR_USUARIO=3
EXPORTACIONES_RETENCION_FILAS_DIAS=7
# Minutos tras los cuales una exportación «en curso» se considera trabada.
EXPORTACIONES_MAX_MINUTOS_EN_CURSO=60

# ── Notificaciones por correo (opcionales) ───────────────────────────────────
NOTIFICACIONES_CORREO_MAX_INTENTOS=5
NOTIFICACIONES_CORREO_BACKOFF_SEGUNDOS=60

# ── PDF y Celery (opcionales) ────────────────────────────────────────────────
# Carpeta con Arial (Arial.ttf, Arial_Bold.ttf...) si no está en la ruta estándar.
# Sin Arial los PDF salen en Helvetica.
# PDF_FUENTES_DIR=/usr/share/fonts/truetype/msttcorefonts
# Archivo de latido del worker de Celery (lo usa el healthcheck de compose.yml).
# CELERY_HEARTBEAT_FILE=/tmp/celery_worker_heartbeat

# ── Registro (logs) ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
