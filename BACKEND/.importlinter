# import-linter - verificacion automatica de los contratos Onion del plan
# (Fase B1.4; reglas B1, B2, B4, B16 del Apendice A).
#
# Uso: lint-imports  (desde BACKEND/)
#
# Pureza de capas y direccion de dependencias por modulo (domain/application
# /presentation) + kernel core/. Cada modulo de dominio (apps.*) tiene:
#   - domain-puro           : su domain no importa framework (B1)
#   - application-puro      : su application no importa framework (B4)
#   - capas                 : presentation -> infrastructure -> application -> domain (B2/B3)
#   - <mod>-no-cruzado      : su domain/application no importa de otros modulos (B16)
#   - <mod>-presentacion-no-cruzado : su presentation no importa de otros modulos (B16)
#   - <mod>-independiente   : modulo nuevo no importa de las apps legadas (B16)
#
# Nota B16 (acoplamiento entre modulos): SOLO la capa `infrastructure` puede
# importar modelos/repos de otros modulos — es la capa de adaptadores que
# implementa los puertos (p.ej. `movimientos` lee `cargos`/`personal` para
# armar el historial; `reportes` lee `personal`/`pasivos`/`cargos`). Las capas
# `domain`, `application` y `presentation` quedan blindadas por los contratos
# `-no-cruzado`/`-presentacion-no-cruzado`. Ver plan §I.2.2 (R-01/R-02).
# django-simple-history permanece instalado porque el codigo legado RAC aun lo
# usa (retiro en B8).

[importlinter]
include_external_packages = True
root_packages =
    core
    apps

[importlinter:contract:core-domain-puro]
name = core.domain no depende de framework ni librerias de I/O (B1)
type = forbidden
source_modules =
    core.domain
forbidden_modules =
    django
    rest_framework
    celery
    boto3
    PIL
    requests

[importlinter:contract:core-capas]
name = capas del kernel apuntan hacia adentro (B2/B3)
type = layers
layers =
    core.presentation
    core.infrastructure
    core.domain

[importlinter:contract:kernel-independiente]
name = el kernel nunca importa de los modulos de dominio (B16)
type = forbidden
source_modules =
    core
forbidden_modules =
    apps


