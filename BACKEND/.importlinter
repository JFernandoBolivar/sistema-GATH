[importlinter:contract:apps-cargos-domain-puro]
name = apps.cargos.domain no depende de framework ni librerias de I/O (B1)
# Excepcion puntual (Fase 2.5): `domain/events.py` usa `django.dispatch.Signal`
# para el patron evento->signal->receiver documentado en la skill
# `arquitectura-onion-feature-scream` — es un despachador de eventos sin
# ORM/HTTP/I-O, no el acoplamiento que B1 busca prevenir.
type = forbidden
source_modules =
    apps.cargos.domain
forbidden_modules =
    django
    rest_framework
    celery
    boto3
    PIL
    requests
ignore_imports =
    apps.cargos.domain.events -> django

