# Variables que docker compose interpola en compose.yml. Copiar a .env en la raíz.
# Generar cada clave con: python3 -c "import secrets;print(secrets.token_urlsafe(32))"

# ── Claves (OBLIGATORIAS, compose falla si faltan) ───────────────────────────
RABBITMQ_USER=gath
RABBITMQ_PASS=<CAMBIAR>
# Solo caracteres URL-safe: va dentro de REDIS_URL.
REDIS_PASS=<CAMBIAR>

# ── Base de datos (opcional) ─────────────────────────────────────────────────
# Host de PostgreSQL visto desde los contenedores. Por defecto, el propio servidor
# (host.docker.internal). Para una BD externa, poner su IP. Tiene prioridad sobre
# DJANGO_DB_HOST de BACKEND/.env.
# DJANGO_DB_HOST=host.docker.internal

# ── URLs públicas (opcionales; por defecto, desarrollo local) ────────────────
# URL pública del frontend (enlaces de correo, validador de carnets). Tiene prioridad
# sobre FRONTEND_URL de BACKEND/.env. En producción, la de HTTPS.
# FRONTEND_URL=http://localhost:3001
# URL pública con la que se abre el sistema (cookies y redirecciones de sesión).
# NEXTAUTH_URL=http://localhost:3001

# ── Puertos publicados en el host (opcionales) ───────────────────────────────
# PUERTO_DJANGO=8001
# PUERTO_NEXTJS=3001

# ── Rutas de volúmenes en el servidor (opcionales) ───────────────────────────
# GATH_MEDIA_DIR=/opt/gath/BACKEND/media
# GATH_STATICFILES_DIR=/opt/gath/BACKEND/staticfiles

# ── Celery (opcional) ────────────────────────────────────────────────────────
# Procesos simultáneos del worker.
# CELERY_CONCURRENCY=2
